@model EventManagement.ViewModels.Profile.InterestsViewModel

@{
    ViewData["Title"] = "Your interests";
}

<h1>Your interests</h1>
<p>Select the topics you’re interested in to help personalize event recommendations.</p>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="status">
        @statusMessage
    </div>
}

<form asp-controller="Profile" asp-action="Interests" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    @if (Model.AvailableInterests.Count == 0)
    {
        <p>No interest categories are available yet.</p>
    }
    else
    {
        <div class="mb-3">
            @foreach (var interest in Model.AvailableInterests)
            {
                var isSelected = Model.SelectedInterestIds.Contains(interest.Id);

                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           id="interest-@interest.Id"
                           name="SelectedInterestIds"
                           value="@interest.Id"
                           checked="@(isSelected ? "checked" : null)" />
                    <label class="form-check-label" for="interest-@interest.Id">
                        @interest.Name
                    </label>
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary">Save interests</button>
    }
</form>