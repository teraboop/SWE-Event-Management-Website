@model EventManagement.ViewModels.Events.EventDetailsViewModel
@using EventManagement.Models.Events
@using EventManagement.Services

@{
    ViewData["Title"] = Model.Title;
}

<a asp-action="Index" class="btn btn-outline-secondary mb-3">Back to Events</a>

@if (Model.BackgroundImageId is int backgroundImageId)
{
    <header class="event-hero" style="--event-hero-image: url('/images/event/@backgroundImageId')">
        <h1 class="event-hero-title">@Model.Title</h1>
    </header>
}
else
{
    <h1>@Model.Title</h1>
}

<partial name="_SaveEventButton"
         model="@(new EventManagement.ViewModels.Events.SaveEventButtonViewModel
         {
             EventId = Model.Id,
             IsSaved = Model.IsSaved,
             ReturnUrl = Model.ReturnUrl
         })" />

<p class="text-muted">
    @Model.StartsAt.LocalDateTime.ToString("MMMM d, yyyy h:mm tt")
    to
    @Model.EndsAt.LocalDateTime.ToString("h:mm tt")
</p>

<p>
    <strong>Location:</strong>
    @Model.VenueName, @Model.City
    @if (!string.IsNullOrWhiteSpace(Model.PostalCode))
    {
        <span>@Model.PostalCode</span>
    }
</p>

<p>
    <strong>Category:</strong> @Model.EventCategoryName
</p>

<p>
    <strong>Organizer:</strong> @Model.OrganizerName
</p>

<p>
    <strong>Price:</strong>
    @(Model.MinimumPrice == 0 ? "Free" : $"From {Model.MinimumPrice:C}")
</p>

<section class="my-4" aria-labelledby="ticketing-heading">
    <h2 id="ticketing-heading" class="h4">Tickets</h2>

    @if (TempData["TicketError"] is string ticketError)
    {
        <div class="alert alert-danger" role="alert">@ticketError</div>
    }

    @switch (Model.TicketSalesMode)
    {
        case TicketSalesMode.External:
            @if (Uri.TryCreate(Model.ExternalTicketingUrl, UriKind.Absolute, out var ticketingUri)
                 && (ticketingUri.Scheme == Uri.UriSchemeHttps || ticketingUri.Scheme == Uri.UriSchemeHttp))
            {
                <a href="@ticketingUri.AbsoluteUri"
                   class="btn btn-outline-primary"
                   target="_blank"
                   rel="noopener noreferrer">
                    View tickets on external site
                </a>
            }
            else
            {
                <p>External ticket information is not currently available.</p>
            }
            break;

        case TicketSalesMode.OnPlatform:
            @if (Model.TicketsHeld > 0)
            {
                <div class="alert alert-info" role="status">
                    You have @Model.TicketsHeld @(Model.TicketsHeld == 1 ? "ticket" : "tickets") for this event.
                    <a asp-controller="Tickets" asp-action="Index" class="alert-link">View my tickets</a>
                </div>
            }

            @if (Model.HasStarted)
            {
                <p>This event has already started, so tickets are no longer on sale.</p>
            }
            else if (Model.AvailableTicketTypes.Count == 0)
            {
                <p>No ticket types are currently on sale.</p>
            }
            else
            {
                // The page only hides or shows the buy controls. The purchase
                // service re-checks every eligibility rule when the form is submitted.
                var canBuy = User.Identity?.IsAuthenticated == true && !Model.IsOwnEvent;

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Ticket</th>
                                <th scope="col">Price</th>
                                <th scope="col">Sales end</th>
                                <th scope="col"><span class="visually-hidden">Buy</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticketType in Model.AvailableTicketTypes)
                            {
                                var maxQuantity = Math.Min(TicketPurchaseService.MaxTicketsPerOrder, ticketType.Remaining);
                                <tr>
                                    <td>
                                        @ticketType.Name
                                        @if (!ticketType.IsSoldOut && ticketType.Remaining <= 10)
                                        {
                                            <div class="small text-muted">Only @ticketType.Remaining left</div>
                                        }
                                    </td>
                                    <td>@(ticketType.Price == 0 ? "Free" : ticketType.Price.ToString("C"))</td>
                                    <td>@ticketType.SalesEndAt.LocalDateTime.ToString("MMMM d, yyyy h:mm tt")</td>
                                    <td class="text-end">
                                        @if (ticketType.IsSoldOut)
                                        {
                                            <span class="badge text-bg-secondary">Sold out</span>
                                        }
                                        else if (canBuy)
                                        {
                                            <form asp-controller="Tickets" asp-action="Purchase" method="post"
                                                  class="d-inline-flex gap-2 justify-content-end">
                                                <input type="hidden" name="eventId" value="@Model.Id" />
                                                <input type="hidden" name="ticketTypeId" value="@ticketType.Id" />
                                                <input type="number" name="quantity" value="1"
                                                       min="1" max="@maxQuantity" step="1"
                                                       class="form-control form-control-sm ticket-quantity"
                                                       aria-label="Number of @ticketType.Name tickets" />
                                                <button type="submit" class="btn btn-primary btn-sm text-nowrap">
                                                    @(ticketType.Price == 0 ? "Get tickets" : "Buy tickets")
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <p>
                        <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
                        to get tickets.
                    </p>
                }
                else if (Model.IsOwnEvent)
                {
                    <p class="text-muted">You organize this event, so you can't buy tickets for it.</p>
                }
                else
                {
                    <p class="text-muted small">
                        Up to @TicketPurchaseService.MaxTicketsPerOrder tickets per order.
                        Online payment isn't available yet, so orders are confirmed immediately.
                    </p>
                }
            }
            break;

        case TicketSalesMode.NotRequired:
            <p>Tickets are not required for this event.</p>
            break;

        default:
            <p>Ticket information has not been configured for this event.</p>
            break;
    }
</section>

@if (Model.IsOwnEvent)
{
    @* Organizers don't see the apply buttons on their own event, so tell them where those settings live. *@
    <section class="card my-4" aria-labelledby="organizer-tools-heading">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h2 id="organizer-tools-heading" class="h5 mb-1">You organize this event</h2>
                <p class="text-muted mb-0">
                    Vendor applications are @(Model.AcceptsVendorApplications ? "open" : "closed").
                    Panel proposals are @(Model.AcceptsPanelApplications ? "open" : "closed").
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-area="Organizer" asp-page="/Events/Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">Edit listing</a>
                <a asp-area="Organizer" asp-page="/Events/Vendors" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">Manage vendors</a>
                <a asp-area="Organizer" asp-page="/Events/Panels" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">Manage panels</a>
            </div>
        </div>
    </section>
}

@if (Model.AcceptsVendorApplications && !Model.HasEnded && !Model.IsOwnEvent)
{
    <section class="my-4" aria-labelledby="vendors-heading">
        <h2 id="vendors-heading" class="h4">Vendors</h2>

        @if (User.Identity?.IsAuthenticated != true)
        {
            <p>
                This event is accepting vendor applications.
                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
                to apply to sell here.
            </p>
        }
        else if (!Model.HasVendorProfile)
        {
            <p>This event is accepting vendor applications. Set up a vendor profile once, then apply with it here and at other events.</p>
            <a asp-area="Vendor" asp-page="/Applications/Apply" asp-route-eventId="@Model.Id" class="btn btn-outline-primary">
                Create vendor profile and apply
            </a>
        }
        else
        {
            @switch (Model.VendorApplicationStatus)
            {
                case EventManagement.Models.Applications.ApplicationStatus.Submitted:
                    <p>
                        Your application to sell at this event is waiting for the organizer's review.
                        <a asp-area="Vendor" asp-page="/Applications/Index">View my applications</a>
                    </p>
                    break;

                case EventManagement.Models.Applications.ApplicationStatus.Approved:
                    <p>You're approved to sell at this event.</p>
                    break;

                default:
                    @if (Model.VendorApplicationStatus == EventManagement.Models.Applications.ApplicationStatus.Rejected)
                    {
                        <p class="text-muted">Your previous application wasn't accepted. You can apply again.</p>
                    }
                    else
                    {
                        <p>This event is accepting vendor applications. Your vendor profile is ready to go.</p>
                    }
                    <a asp-area="Vendor" asp-page="/Applications/Apply" asp-route-eventId="@Model.Id" class="btn btn-outline-primary">
                        Apply to sell at this event
                    </a>
                    break;
            }
        }
    </section>
}

@{
    var canProposePanel = Model.AcceptsPanelApplications && !Model.HasEnded && !Model.IsOwnEvent;
}
@if (Model.ApprovedPanels.Count > 0 || canProposePanel)
{
    <section class="my-4" aria-labelledby="panels-heading">
        <h2 id="panels-heading" class="h4">Panels</h2>

        @foreach (var panel in Model.ApprovedPanels)
        {
            <article class="event-panel">
                <h3 class="h5 mb-1">@panel.Title</h3>
                <p class="small text-muted mb-2">@EventManagement.Services.PanelApplicationService.FormatDuration(panel.DurationMinutes)</p>
                <p class="text-prewrap mb-2">@panel.Description</p>
                <p class="small text-prewrap mb-0"><strong>Panelists:</strong> @panel.Panelists</p>
            </article>
        }

        @if (canProposePanel)
        {
            @if (User.Identity?.IsAuthenticated != true)
            {
                <p>
                    This event is accepting panel proposals.
                    <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
                    to propose one.
                </p>
            }
            else
            {
                <p>
                    This event is accepting panel proposals.
                    @if (Model.PendingPanelProposals > 0)
                    {
                        <span>
                            You have @Model.PendingPanelProposals @(Model.PendingPanelProposals == 1 ? "proposal" : "proposals") waiting for the organizer's review.
                            <a asp-area="Panels" asp-page="/Index">View my proposals</a>
                        </span>
                    }
                </p>
                @if (Model.PendingPanelProposals < EventManagement.Services.PanelApplicationService.MaxPendingPerEvent)
                {
                    <a asp-area="Panels" asp-page="/Apply" asp-route-eventId="@Model.Id" class="btn btn-outline-primary">
                        Propose a panel
                    </a>
                }
            }
        }
    </section>
}

@if (Model.Interests.Count > 0)
{
    <p>
        <strong>Interests:</strong>
        @string.Join(" · ", Model.Interests)
    </p>
}

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <hr />
    <h2 class="h4">About this event</h2>
    <p>@Model.Description</p>
}

@if (!string.IsNullOrWhiteSpace(Model.ExternalWebsiteUrl))
{
    <a href="@Model.ExternalWebsiteUrl"
       class="btn btn-outline-primary"
       target="_blank"
       rel="noopener noreferrer">
        Visit Event Website
    </a>
}