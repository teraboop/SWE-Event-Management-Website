@model EventManagement.ViewModels.Events.EventListViewModel

@{
    ViewData["Title"] = "Events";
    var eventListReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="events-page">
    <header class="events-page-header">
        <p class="events-page-eyebrow">Upcoming events</p>
        <h1>Find your next event</h1>
        <p class="events-page-lead">
            Browse upcoming conventions, narrow the list to what matters to you, and save your favorites for later.
        </p>
    </header>

    <section class="events-filter-panel" aria-labelledby="events-filter-heading">
        <div class="events-filter-header">
            <div>
                <p class="events-filter-kicker">Discover</p>
                <h2 id="events-filter-heading">Find your next event</h2>
            </div>
            <a asp-controller="Events" asp-action="Index" class="events-clear-filters">
                Clear filters
            </a>
        </div>

        <form method="get" class="events-filter-form">
            <div class="events-filter-field">
                <label asp-for="Filter.InterestCategoryId" class="form-label">Interest</label>
                <select asp-for="Filter.InterestCategoryId" class="form-select">
                    <option value="">All interests</option>
                    @foreach (var category in Model.InterestCategories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>

            <div class="events-filter-field">
                <label asp-for="Filter.City" class="form-label">City</label>
                <input asp-for="Filter.City" class="form-control" placeholder="Any city" />
            </div>

            <div class="events-filter-field">
                <label asp-for="Filter.StartsAfter" class="form-label">Starts after</label>
                <input asp-for="Filter.StartsAfter" type="date" class="form-control" />
            </div>

            <div class="events-filter-field">
                <label asp-for="Filter.MaximumPrice" class="form-label">Maximum price</label>
                <input asp-for="Filter.MaximumPrice"
                       type="number"
                       min="0"
                       step="0.01"
                       class="form-control"
                       placeholder="Any price" />
            </div>

            <fieldset class="events-filter-field events-filter-checks">
                <legend class="visually-hidden">Open to applications</legend>
                <div class="form-check">
                    <input type="checkbox"
                           id="Filter_OpenToVendors"
                           name="Filter.OpenToVendors"
                           value="true"
                           class="form-check-input"
                           checked="@Model.Filter.OpenToVendors" />
                    <label for="Filter_OpenToVendors" class="form-check-label">Open to vendors</label>
                </div>
                <div class="form-check">
                    <input type="checkbox"
                           id="Filter_OpenToPanels"
                           name="Filter.OpenToPanels"
                           value="true"
                           class="form-check-input"
                           checked="@Model.Filter.OpenToPanels" />
                    <label for="Filter_OpenToPanels" class="form-check-label">Open to panels</label>
                </div>
            </fieldset>

            <div class="events-filter-submit">
                <button type="submit" class="btn btn-primary">Apply filters</button>
            </div>
        </form>
    </section>

    <div class="events-results-header" aria-live="polite">
        <div>
            <p class="events-results-kicker">Browse conventions</p>
            <h2>@Model.Events.Count @(Model.Events.Count == 1 ? "event" : "events") found</h2>
        </div>
        <p>Showing published upcoming events</p>
    </div>

    @if (Model.Events.Count == 0)
    {
        <div class="events-empty-state">
            <span class="events-empty-icon" aria-hidden="true">✦</span>
            <h2>No matching events found</h2>
            <p>Try changing your city, date, interest, or price to discover more upcoming events.</p>
            <a asp-controller="Events" asp-action="Index" class="btn btn-primary">View all events</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var eventCard in Model.Events)
            {
                <div class="col">
                    <article class="events-result-card h-100">
                        <div class="events-result-card-body">
                            <p class="events-result-date">
                                @eventCard.StartsAt.LocalDateTime.ToString("ddd, MMM d, yyyy · h:mm tt")
                            </p>

                            <h2 class="events-result-title">
                                <a asp-controller="Events"
                                   asp-action="Details"
                                   asp-route-id="@eventCard.Id">
                                    @eventCard.Title
                                </a>
                            </h2>

                            <p class="events-result-location">
                                <span aria-hidden="true">●</span>
                                @eventCard.VenueName, @eventCard.City
                            </p>

                            <partial name="_OpenApplicationBadges"
                                     model="(eventCard.AcceptsVendorApplications, eventCard.AcceptsPanelApplications)" />

                            @if (eventCard.Interests.Count > 0)
                            {
                                <ul class="events-result-tags list-unstyled">
                                    @foreach (var interest in eventCard.Interests)
                                    {
                                        <li>@interest</li>
                                    }
                                </ul>
                            }

                            <p class="events-result-price">
                                @(eventCard.MinimumPrice == 0
                                    ? "Free"
                                    : $"From {eventCard.MinimumPrice:C}")
                            </p>
                        </div>

                        <div class="events-card-actions">
                            <button type="button"
                                    class="btn btn-outline-primary event-summary-button"
                                    data-summary-url="@Url.Action("Summary", "Events", new {
                                        id = eventCard.Id,
                                        returnUrl = eventListReturnUrl
                                    })">
                                Quick View
                            </button>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@eventCard.Id"
                               class="btn btn-primary">
                                View details
                            </a>

                            <partial name="_SaveEventButton"
                                     model="@(new EventManagement.ViewModels.Events.SaveEventButtonViewModel
                                     {
                                         EventId = eventCard.Id,
                                         IsSaved = eventCard.IsSaved,
                                         ReturnUrl = eventListReturnUrl
                                     })" />
                        </div>
                    </article>
                </div>
            }
        </div>

        <div id="event-summary-modal-host"></div>

        @section Scripts {
            <script>
                document.querySelectorAll(".event-summary-button").forEach(button => {
                    button.addEventListener("click", async () => {
                        const response = await fetch(button.dataset.summaryUrl);

                        if (!response.ok) {
                            alert("Unable to load the event summary.");
                            return;
                        }

                        const modalHost = document.getElementById("event-summary-modal-host");
                        modalHost.innerHTML = await response.text();

                        const modalElement = document.getElementById("eventSummaryModal");
                        const modal = bootstrap.Modal.getOrCreateInstance(modalElement);

                        modal.show();
                    });
                });
            </script>
        }
    }
</div>
