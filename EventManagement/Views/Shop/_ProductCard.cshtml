@model EventManagement.ViewModels.Shop.ProductCardViewModel

@* One product in a grid. Set view-data["HideVendor"] = true on a vendor's own storefront. *@
@{
    var hideVendor = ViewData["HideVendor"] is true;
}
<article class="card product-card h-100">
    <div class="product-card-image">
        @if (Model.ImageId is int imageId)
        {
            <img src="/images/product/@imageId" alt="" loading="lazy" />
        }
        else
        {
            <span class="product-card-placeholder" aria-hidden="true">@Model.Name[..1].ToUpperInvariant()</span>
        }
        @if (!Model.IsInStock)
        {
            <span class="product-stock-badge">Out of stock</span>
        }
    </div>
    <div class="card-body d-flex flex-column">
        <h3 class="card-title h6 mb-1">
            <a class="stretched-link" asp-controller="Shop" asp-action="Product" asp-route-id="@Model.Id">@Model.Name</a>
        </h3>
        @if (!hideVendor)
        {
            <p class="card-text small text-muted mb-2">@Model.VendorName</p>
        }
        <p class="product-card-price mt-auto mb-0">@Model.Price.ToString("C")</p>
    </div>
</article>
