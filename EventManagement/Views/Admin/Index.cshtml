@model EventManagement.ViewModels.Admin.AdminIndexViewModel

@{
    ViewData["Title"] = "Admin";
}

<h1>Admin area</h1>
<p>Only users assigned the Admin role can access this page.</p>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info" role="status">@statusMessage</div>
}

<section class="card mt-4" aria-labelledby="event-review-heading">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h2 id="event-review-heading" class="h5 mb-1">Event applications</h2>
            <p class="text-muted mb-0">
                @(Model.PendingEventApplications == 0
                    ? "No applications to list an event are waiting for review."
                    : $"{Model.PendingEventApplications} waiting for review.")
            </p>
        </div>
        <a asp-controller="Admin" asp-action="EventApplications" class="btn btn-outline-primary">Review applications</a>
    </div>
</section>

<section class="card mt-3" aria-labelledby="vendor-review-heading">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h2 id="vendor-review-heading" class="h5 mb-1">Online vendor applications</h2>
            <p class="text-muted mb-0">
                @(Model.PendingOnlineVendorApplications == 0
                    ? "No applications to sell online are waiting for review."
                    : $"{Model.PendingOnlineVendorApplications} waiting for review.")
            </p>
        </div>
        <a asp-controller="Admin" asp-action="VendorApplications" class="btn btn-outline-primary">Review applications</a>
    </div>
</section>

<h2 class="h4 mt-4">Organizer accounts</h2>
<p>Grant or remove the Organizer role for existing accounts.</p>

@if (Model.Users.Count == 0)
{
    <p>No user accounts were found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">User</th>
                    <th scope="col">Email</th>
                    <th scope="col">Organizer access</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in Model.Users)
                {
                    <tr>
                        <td>
                            <div>@(string.IsNullOrWhiteSpace(account.DisplayName) ? account.UserName : account.DisplayName)</div>
                            @if (!string.IsNullOrWhiteSpace(account.DisplayName) &&
                                 !string.IsNullOrWhiteSpace(account.UserName))
                            {
                                <small class="text-muted">@account.UserName</small>
                            }
                        </td>
                        <td>@account.Email</td>
                        <td>@(account.IsOrganizer ? "Organizer" : "Not an organizer")</td>
                        <td class="text-end">
                            <form asp-controller="Admin" asp-action="SetOrganizerRole" method="post">
                                <input type="hidden" name="userId" value="@account.Id" />
                                <input type="hidden" name="makeOrganizer" value="@(account.IsOrganizer ? "false" : "true")" />
                                <button type="submit"
                                        class="btn btn-sm @(account.IsOrganizer ? "btn-outline-danger" : "btn-outline-primary")">
                                    @(account.IsOrganizer ? "Remove Organizer" : "Make Organizer")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
