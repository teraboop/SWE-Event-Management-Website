@model EventManagement.ViewModels.Reviews.EventReviewsViewModel
@using EventManagement.Models.Events
@using EventManagement.Services
@using EventManagement.ViewModels.Reviews

@*
    The Reviews section of an event page, shown once the event has ended:
    the rating summary, the viewer's own review (or the form to write one),
    and the latest reviews.
*@
@{
    var summary = Model.Summary;
    var myReview = Model.MyReview;

    // The form for writing or editing. Rendered once, either open (no review
    // yet) or inside the "Edit" disclosure under the viewer's review.
    async Task RenderForm()
    {
        <form asp-controller="Reviews" asp-action="Save" method="post" class="review-form">
            <input type="hidden" name="eventId" value="@Model.EventId" />

            <fieldset class="star-input mb-3">
                <legend class="form-label fw-semibold mb-1">Your rating</legend>
                <div class="star-input-options">
                    @for (var stars = EventReviewService.MaxRating; stars >= EventReviewService.MinRating; stars--)
                    {
                        <input type="radio"
                               class="star-input-radio"
                               id="review-rating-@stars"
                               name="rating"
                               value="@stars"
                               required
                               checked="@(myReview?.Rating == stars)" />
                        <label for="review-rating-@stars" title="@stars @(stars == 1 ? "star" : "stars")">
                            <span aria-hidden="true">★</span>
                            <span class="visually-hidden">@stars @(stars == 1 ? "star" : "stars")</span>
                        </label>
                    }
                </div>
            </fieldset>

            <div class="mb-3">
                <label for="review-comment" class="form-label fw-semibold">Your review (optional)</label>
                <textarea id="review-comment"
                          name="comment"
                          class="form-control"
                          rows="4"
                          maxlength="@EventReviewService.MaxCommentLength"
                          aria-describedby="review-comment-help">@myReview?.Comment</textarea>
                <div id="review-comment-help" class="form-text">
                    What stood out? Your review is shown with the display name from
                    <a asp-controller="Profile" asp-action="Index">your profile</a>.
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                @(myReview is null ? "Post review" : "Save changes")
            </button>
        </form>
    }

    // confirmText ends up inside an inline script, so it must not contain quotes or apostrophes.
    async Task RenderDeleteButton(EventReviewItem review, string text, string confirmText)
    {
        <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@review.Id" method="post"
              class="d-inline" onsubmit="return confirm('@confirmText');">
            <button type="submit" class="btn btn-link btn-sm text-danger p-0">@text</button>
        </form>
    }

    async Task RenderReview(EventReviewItem review)
    {
        <header class="review-header">
            <partial name="_StarRating" model="(double)review.Rating" />
            <span class="fw-semibold">@review.AuthorName</span>
            <span class="review-verified">Verified ticket holder</span>
        </header>
        <p class="small text-muted mb-2">
            @review.CreatedAt.LocalDateTime.ToString("MMMM d, yyyy")
            @if (review.UpdatedAt is DateTimeOffset updatedAt)
            {
                <span>· edited @updatedAt.LocalDateTime.ToString("MMMM d, yyyy")</span>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(review.Comment))
        {
            <p class="text-prewrap mb-0">@review.Comment</p>
        }
    }
}

<section class="my-4" id="reviews" aria-labelledby="reviews-heading">
    <h2 id="reviews-heading" class="h4">Reviews</h2>

    @if (TempData["ReviewMessage"] is string reviewMessage)
    {
        <div class="alert alert-success" role="status">@reviewMessage</div>
    }
    @if (TempData["ReviewError"] is string reviewError)
    {
        <div class="alert alert-danger" role="alert">@reviewError</div>
    }

    @if (summary.HasReviews)
    {
        <div class="review-summary">
            <div class="review-summary-score">
                <span class="review-summary-average">@summary.AverageText</span>
                <partial name="_StarRating" model="summary.Average" />
                <span class="text-muted small">@summary.CountText</span>
            </div>
            <ul class="review-breakdown list-unstyled mb-0">
                @for (var stars = EventReviewService.MaxRating; stars >= EventReviewService.MinRating; stars--)
                {
                    <li>
                        <span class="review-breakdown-label">@stars <span aria-hidden="true">★</span><span class="visually-hidden">@(stars == 1 ? "star" : "stars")</span></span>
                        <span class="review-bar" aria-hidden="true"><span style="width: @summary.PercentFor(stars)%"></span></span>
                        <span class="review-breakdown-count">@summary.CountFor(stars)</span>
                    </li>
                }
            </ul>
        </div>
    }
    else
    {
        <p class="text-muted">No reviews yet.</p>
    }

    @* The viewer's own review, or what's stopping them from writing one. *@
    @if (myReview is not null)
    {
        <article class="event-review event-review-own">
            <h3 class="h6 text-uppercase text-muted mb-2">Your review</h3>
            @{ await RenderReview(myReview); }

            <div class="d-flex flex-wrap gap-3 align-items-center mt-3">
                @if (Model.CanReview)
                {
                    <details class="review-edit w-100">
                        <summary class="btn btn-outline-primary btn-sm">Edit review</summary>
                        <div class="mt-3">
                            @{ await RenderForm(); }
                        </div>
                    </details>
                }
                @{ await RenderDeleteButton(myReview, "Delete my review", "Delete your review of this event?"); }
            </div>
        </article>
    }
    else if (Model.CanReview)
    {
        <div class="event-review event-review-own">
            <h3 class="h5">Went to this event? Leave a review</h3>
            @{ await RenderForm(); }
        </div>
    }
    else
    {
        switch (Model.Ineligibility)
        {
            case ReviewIneligibilityReason.NotSignedIn:
                <p>
                    Went to this event?
                    <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@($"{Model.ReturnUrl}#reviews")">Log in</a>
                    to leave a review.
                </p>
                break;

            case ReviewIneligibilityReason.OrganizerOwnEvent:
                <p class="text-muted small">You organize this event, so you can't review it.</p>
                break;

            case ReviewIneligibilityReason.NoVerifiedTicket:
                <p class="text-muted small">
                    @(Model.TicketSalesMode == TicketSalesMode.OnPlatform
                        ? "Reviews are open to attendees who got tickets through this site."
                        : "Reviews are open to attendees who got tickets through this site, and this event's tickets weren't sold here.")
                </p>
                break;
        }
    }

    @{
        var otherReviews = Model.Reviews.Where(review => !review.IsOwn).ToList();
    }
    @foreach (var review in otherReviews)
    {
        <article class="event-review">
            @{ await RenderReview(review); }
            @if (Model.ViewerIsAdmin)
            {
                <div class="mt-2">
                    @{ await RenderDeleteButton(review, "Remove review (admin)", "Remove this review? This cannot be undone."); }
                </div>
            }
        </article>
    }

    @if (summary.Count > Model.Reviews.Count)
    {
        <p class="text-muted small">Showing the @Model.Reviews.Count most recent of @summary.CountText.</p>
    }
</section>
