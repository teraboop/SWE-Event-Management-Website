@using Microsoft.AspNetCore.Identity
@using EventManagement.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject EventManagement.Services.CartService CartService
@inject EventManagement.Services.RewardService RewardService

<ul class="navbar-nav align-items-md-center gap-md-2">
@if (SignInManager.IsSignedIn(User))
{
    var cartCount = await CartService.CountAsync(UserManager.GetUserId(User)!);
    <li class="nav-item">
        <a class="nav-link cart-nav-link" asp-area="" asp-controller="Cart" asp-action="Index">
            Cart
            @if (cartCount > 0)
            {
                <span class="badge rounded-pill text-bg-primary">@cartCount</span>
                <span class="visually-hidden">@(cartCount == 1 ? "item" : "items")</span>
            }
        </a>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            @User.Identity?.Name
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Profile &amp; settings</a>
            </li>
            <li><hr class="dropdown-divider" /></li>
                <li>
                    <a class="dropdown-item"
                       asp-area=""
                       asp-controller="Profile"
                       asp-action="Index">
                        My profile
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-area=""
                       asp-controller="Tickets"
                       asp-action="Index">
                        My tickets
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-area=""
                       asp-controller="Orders"
                       asp-action="Index">
                        My orders
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex justify-content-between gap-3"
                       asp-area=""
                       asp-controller="Rewards"
                       asp-action="Index">
                        <span>My rewards</span>
                        <span class="text-muted small">@(await RewardService.GetBalanceAsync(UserManager.GetUserId(User)!)) pts</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-area="Vendor"
                       asp-page="/Applications/Index">
                        Vendor applications
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-area="Vendor"
                       asp-page="/Products/Index">
                        My products
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-area="Panels"
                       asp-page="/Index">
                        Panel proposals
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-area="Hosting"
                       asp-page="/Index">
                        Event applications
                    </a>
                </li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item">Log out</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Log in</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm px-3" asp-area="Identity" asp-page="/Account/Register">Sign up</a>
    </li>
}
</ul>
