@model EventManagement.ViewModels.Events.SaveEventButtonViewModel

@if (User.Identity?.IsAuthenticated == true)
{
    <form asp-controller="Events"
          asp-action="@(Model.IsSaved ? "Unsave" : "Save")"
          method="post"
          class="d-inline">
        <input type="hidden" name="id" value="@Model.EventId" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

        <button type="submit"
                class="btn @(Model.IsSaved ? "btn-outline-secondary" : "btn-outline-primary")">
            @(Model.IsSaved ? "Remove saved event" : "Save event")
        </button>
    </form>
}
else
{
    <a class="btn btn-outline-primary"
       asp-area="Identity"
       asp-page="/Account/Login"
       asp-route-returnUrl="@Model.ReturnUrl">
        Sign in to save
    </a>
}