@page
@model EventManagement.Areas.Hosting.Pages.ApplyModel

@{
    ViewData["Title"] = "Apply to list an event";
    ViewData["ListingOptions"] = Model.ListingOptions;
}

<a asp-page="./Index" class="btn btn-outline-secondary mb-3">Back to my event applications</a>

<h1>@ViewData["Title"]</h1>

@if (Model.PendingCount >= EventApplicationService.MaxPending)
{
    <div class="alert alert-secondary" role="status">
        You already have @Model.PendingCount applications waiting for review. Withdraw one or wait for a decision before applying again.
        <a asp-page="./Index" class="alert-link">View my event applications</a>
    </div>
}
else
{
    <p>
        Tell us about your event. An admin will review your application. Once it's approved,
        the event is listed on the site and you become its organizer, so you can edit the listing,
        set up tickets, and take vendor and panel applications.
    </p>

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <partial name="_EventListingFields" for="Input" />

        <fieldset class="mb-4">
            <legend class="h5">Your contact details</legend>
            <p class="text-muted small">Only admins see these. They aren't shown on the event page.</p>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Input.ContactName" class="form-label"></label>
                    <input asp-for="Input.ContactName" class="form-control" maxlength="150" autocomplete="name" />
                    <span asp-validation-for="Input.ContactName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.OrganizationName" class="form-label"></label>
                    <input asp-for="Input.OrganizationName" class="form-control" maxlength="150" autocomplete="organization" />
                    <span asp-validation-for="Input.OrganizationName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ContactEmail" class="form-label"></label>
                    <input asp-for="Input.ContactEmail" class="form-control" maxlength="256" autocomplete="email" />
                    <span asp-validation-for="Input.ContactEmail" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ContactPhone" class="form-label"></label>
                    <input asp-for="Input.ContactPhone" class="form-control" maxlength="30" autocomplete="tel" />
                    <span asp-validation-for="Input.ContactPhone" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Message" class="form-label"></label>
                <textarea asp-for="Input.Message" class="form-control" rows="3" maxlength="1000"
                          placeholder="Anything the reviewer should know, e.g. past events you've run"></textarea>
                <span asp-validation-for="Input.Message" class="text-danger"></span>
            </div>
        </fieldset>

        <button type="submit" class="btn btn-primary">Submit application</button>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
