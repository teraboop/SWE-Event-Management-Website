@page "{id:int}"
@model EventManagement.Areas.Organizer.Pages.Events.EditModel

@{
    ViewData["Title"] = "Edit listing";
    ViewData["ListingOptions"] = Model.ListingOptions;
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-page="./Index" class="btn btn-outline-secondary">Back to events</a>
    @if (Model.Status == EventStatus.Published)
    {
        <a asp-area="" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-outline-primary">View event page</a>
    }
</div>

<h1>Edit listing</h1>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}

<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <partial name="_EventListingFields" for="Input" />

    <button type="submit" class="btn btn-primary">Save listing</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
