@page "{id:int}"
@model EventManagement.Areas.Organizer.Pages.Events.PanelsModel
@using EventManagement.Models.Applications

@{
    ViewData["Title"] = "Panels";
    var pending = Model.Applications.Where(application => application.Status == ApplicationStatus.Submitted).ToList();
    var approved = Model.Applications.Where(application => application.Status == ApplicationStatus.Approved).ToList();
    var otherDecided = Model.Applications
        .Where(application => application.Status is ApplicationStatus.Rejected or ApplicationStatus.Withdrawn)
        .ToList();
}

<a asp-page="./Index" class="btn btn-outline-secondary mb-3">Back to events</a>

<h1>Panels for @Model.EventTitle</h1>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<section class="card mb-4" aria-labelledby="accepting-heading">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h2 id="accepting-heading" class="h5 mb-1">Panel proposals are @(Model.AcceptsPanelApplications ? "open" : "closed")</h2>
            <p class="text-muted mb-0">
                @(Model.AcceptsPanelApplications
                    ? "Attendees see a \"Propose a panel\" button on the event page. Approved panels are listed there too."
                    : "Open proposals to let attendees propose panels for this event. Approved panels stay listed either way.")
            </p>
        </div>
        <form method="post" asp-page-handler="SetAccepting" asp-route-id="@Model.EventId">
            @* Written as text: Razor renders a bare bool attribute as value="value" or drops it. *@
            <input type="hidden" name="accepting" value="@(Model.AcceptsPanelApplications ? "false" : "true")" />
            <button type="submit" class="btn @(Model.AcceptsPanelApplications ? "btn-outline-secondary" : "btn-primary")">
                @(Model.AcceptsPanelApplications ? "Close proposals" : "Open proposals")
            </button>
        </form>
    </div>
</section>

<h2 class="h4">Pending (@pending.Count)</h2>
@if (pending.Count == 0)
{
    <p>No proposals are waiting for review.</p>
}
else
{
    @foreach (var application in pending)
    {
        <partial name="_PanelApplicationReview" model="application" />
    }
}

@if (approved.Count > 0)
{
    <h2 class="h4 mt-4">Approved (@approved.Count)</h2>
    @foreach (var application in approved)
    {
        <partial name="_PanelApplicationReview" model="application" />
    }
}

@if (otherDecided.Count > 0)
{
    <h2 class="h4 mt-4">Rejected or withdrawn</h2>
    @foreach (var application in otherDecided)
    {
        <partial name="_PanelApplicationReview" model="application" />
    }
}
