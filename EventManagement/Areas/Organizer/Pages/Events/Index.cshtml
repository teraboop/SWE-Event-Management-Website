@page
@model EventManagement.Areas.Organizer.Pages.Events.IndexModel

@{
    ViewData["Title"] = Model.IsAdmin ? "All events" : "My events";
}

<h1>@ViewData["Title"]</h1>

@if (Model.Events.Count == 0)
{
    <p>
        You don't organize any events yet.
        <a asp-area="Hosting" asp-page="/Apply">Apply to list an event</a>
    </p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Event</th>
                    @if (Model.IsAdmin)
                    {
                        <th scope="col">Organizer</th>
                    }
                    <th scope="col">Starts</th>
                    <th scope="col">Status</th>
                    <th scope="col">Ticket sales</th>
                    <th scope="col">Sold</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Events)
                {
                    <tr>
                        <td>
                            @if (row.Status == EventStatus.Published)
                            {
                                <a asp-area="" asp-controller="Events" asp-action="Details" asp-route-id="@row.Id">@row.Title</a>
                            }
                            else
                            {
                                @row.Title
                            }
                        </td>
                        @if (Model.IsAdmin)
                        {
                            <td>@row.OrganizerName</td>
                        }
                        <td>@row.StartsAt.LocalDateTime.ToString("MMM d, yyyy h:mm tt")</td>
                        <td>@row.Status</td>
                        <td>
                            @(row.TicketSalesMode switch
                            {
                                TicketSalesMode.OnPlatform => "On this platform",
                                TicketSalesMode.External => "External site",
                                TicketSalesMode.NotRequired => "Not required",
                                _ => "Not configured"
                            })
                        </td>
                        <td>
                            @if (row.TicketSalesMode == TicketSalesMode.OnPlatform)
                            {
                                @($"{row.TicketsSold} / {row.TicketCapacity}")
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-page="./Edit" asp-route-id="@row.Id" class="btn btn-outline-primary btn-sm text-nowrap">Edit listing</a>
                                <a asp-page="./Ticketing" asp-route-id="@row.Id" class="btn btn-outline-primary btn-sm text-nowrap">Ticket settings</a>
                                <a asp-page="./Vendors" asp-route-id="@row.Id" class="btn btn-outline-primary btn-sm text-nowrap">
                                    Vendors
                                    @if (row.PendingVendorApplications > 0)
                                    {
                                        <span class="badge text-bg-warning ms-1">@row.PendingVendorApplications</span>
                                        <span class="visually-hidden">pending</span>
                                    }
                                    else if (!row.AcceptsVendorApplications)
                                    {
                                        <span class="small text-muted ms-1">(closed)</span>
                                    }
                                </a>
                                <a asp-page="./Panels" asp-route-id="@row.Id" class="btn btn-outline-primary btn-sm text-nowrap">
                                    Panels
                                    @if (row.PendingPanelApplications > 0)
                                    {
                                        <span class="badge text-bg-warning ms-1">@row.PendingPanelApplications</span>
                                        <span class="visually-hidden">pending</span>
                                    }
                                    else if (!row.AcceptsPanelApplications)
                                    {
                                        <span class="small text-muted ms-1">(closed)</span>
                                    }
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
